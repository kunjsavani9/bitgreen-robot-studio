# Copy to .env and fill in. Never commit .env.

# Admin account — the one username/email pair allowed to open /host
ROS_ADMIN_USERNAME=admin
ROS_ADMIN_EMAIL=admin@example.com

# Gmail SMTP for signup OTP (use a 16-char App Password, not your login password)
ROS_SMTP_USER=you@gmail.com
ROS_SMTP_PASS=
